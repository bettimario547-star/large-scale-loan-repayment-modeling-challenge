{
  "protocol_version": 1,
  "parent_run_name": "sql_business_analysis",
  "threads": 4,
  "memory_limit": "1GB",
  "policy_split": {"evaluation_fraction": 0.4, "random_seed": 20261025, "stratify_label": true},
  "target_approval_rates": [0.0, 0.3, 0.4, 0.5, 0.6, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0],
  "constraints": {"max_development_default_rate": 0.05, "min_development_approval_rate": 0.5},
  "economics": {
    "currency": "CNY_assumed",
    "horizon_months": 12,
    "principal": 10000.0,
    "interest_rate_for_horizon": 0.12,
    "loss_given_default": 0.8,
    "funding_rate_for_horizon": 0.04,
    "servicing_cost_per_approved": 100.0,
    "application_cost_per_application": 10.0
  },
  "sensitivity_scenarios": [
    {"scenario_id": "base", "overrides": {}},
    {"scenario_id": "lower_interest", "overrides": {"interest_rate_for_horizon": 0.08}},
    {"scenario_id": "full_principal_loss", "overrides": {"loss_given_default": 1.0}},
    {"scenario_id": "higher_funding", "overrides": {"funding_rate_for_horizon": 0.06}},
    {"scenario_id": "smaller_principal", "overrides": {"principal": 5000.0}},
    {"scenario_id": "larger_principal", "overrides": {"principal": 20000.0}}
  ],
  "selection_rule": "base_scenario_policy_development_only_maximize_realized_profit_per_application_subject_to_constraints_then_lower_default_rate_lower_approval_rate_policy_id",
  "probability_calibration": "none_use_raw_score_implied_profit_as_diagnostic_only",
  "offline_outcome_assumption": "historical_repayment_label_unchanged_by_approval_decision_and_loan_terms"
}
