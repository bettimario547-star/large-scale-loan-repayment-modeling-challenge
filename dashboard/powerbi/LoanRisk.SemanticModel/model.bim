            "formatString": "0.00%",
            "lineageTag": "f82827e4-eef8-442b-bbec-92bb4a634e90"
          },
          {
            "name": "当前经济假设",
            "expression": "SELECTEDVALUE(Scenarios[Scenario], \"基准假设（默认）\")",
            "lineageTag": "f70ffdcf-2fa0-4d80-a76a-2cadbfafbf01"
