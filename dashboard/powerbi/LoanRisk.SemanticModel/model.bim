            "name": "假设本金",
            "expression": "VAR Chosen = SELECTEDVALUE(Scenarios[ScenarioId], \"base\") RETURN CALCULATE(MAX(EconomicAssumptions[Principal]), REMOVEFILTERS(Scenarios), EconomicAssumptions[ScenarioId] = Chosen)",
            "formatString": "#,0",
            "lineageTag": "b483a102-3b9c-493b-9616-11d1c6498ed7"
          },
          {
            "name": "假设利息率",
            "expression": "VAR Chosen = SELECTEDVALUE(Scenarios[ScenarioId], \"base\") RETURN CALCULATE(MAX(EconomicAssumptions[InterestRate]), REMOVEFILTERS(Scenarios), EconomicAssumptions[ScenarioId] = Chosen)",
            "formatString": "0.00%",
