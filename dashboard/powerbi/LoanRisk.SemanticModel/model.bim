        "partitions": [
          {
            "name": "ModelMetrics",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"\\ModelMetrics.csv\"), [Delimiter=\",\", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"ROCAUC\", \"DefaultPRAUC\", \"KS\", \"Rows\", \"HistoricalDefaultRate\", \"LogLoss\", \"BrierScore\"}),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"ModelVersion\", type text}, {\"ModelRole\", type text}, {\"ROCAUC\", type number}, {\"DefaultPRAUC\", type number}, {\"KS\", type number}, {\"Rows\", Int64.Type}, {\"HistoricalDefaultRate\", type number}, {\"LogLoss\", type number}, {\"BrierScore\", type number}, {\"Model\", type text}, {\"EvidenceCategory\", type text}, {\"EvidenceBasis\", type text}, {\"PopulationScope\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
