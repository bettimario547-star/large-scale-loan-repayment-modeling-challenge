        "description": "真实未知结果保持NULL；所有晋级状态均为固定证据，不允许用交互假设替代。",
        "lineageTag": "0e505953-f95c-4846-820a-9d855dae914c",
        "measures": [
          {
            "name": "冻结收益差",
            "description": "固定V2证据，不随页面选择变成新实验结果",
            "expression": "CALCULATE(MAX(DashboardState[ProfitDelta]), REMOVEFILTERS())",
            "formatString": "+0.000;-0.000;0.000",
            "lineageTag": "fc35f05c-cdfa-4fc6-9ebd-dc801b75042c"
          },
          {
            "name": "冻结收益下界",
            "description": "固定V2证据，不随页面选择变成新实验结果",
            "expression": "CALCULATE(MAX(DashboardState[ProfitLow]), REMOVEFILTERS())",
            "formatString": "+0.000;-0.000;0.000",
            "lineageTag": "ca27b2e8-378c-4ce8-8e09-112b3883445a"
          },
          {
            "name": "冻结收益上界",
            "description": "固定V2证据，不随页面选择变成新实验结果",
            "expression": "CALCULATE(MAX(DashboardState[ProfitHigh]), REMOVEFILTERS())",
            "formatString": "+0.000;-0.000;0.000",
            "lineageTag": "46b2d7d3-90af-4d75-b3ec-40aa3783fcc3"
          },
          {
            "name": "业务收益门槛",
            "description": "固定V2证据，不随页面选择变成新实验结果",
            "expression": "CALCULATE(MAX(DashboardState[BusinessThreshold]), REMOVEFILTERS())",
            "formatString": "0.000",
            "lineageTag": "98402939-e7c1-44a8-8584-bcbf22596619"
          },
          {
            "name": "冻结分歧样本",
            "description": "固定V2证据，不随页面选择变成新实验结果",
            "expression": "CALCULATE(MAX(DashboardState[CurrentSamples]), REMOVEFILTERS())",
            "formatString": "#,0",
            "lineageTag": "487c052f-152b-4655-b7dc-b0301335c58e"
          },
          {
            "name": "所需分歧样本",
            "description": "固定V2证据，不随页面选择变成新实验结果",
            "expression": "CALCULATE(MAX(DashboardState[RequiredSamples]), REMOVEFILTERS())",
            "formatString": "#,0",
            "lineageTag": "da3559a6-21c5-43ad-b31b-80702bcab9ee"
          },
          {
            "name": "完整B模拟风险上界",
            "description": "固定V2证据，不随页面选择变成新实验结果",
            "expression": "CALCULATE(MAX(DashboardState[BApprovedRiskUpper]), REMOVEFILTERS())",
            "formatString": "0.00%",
            "lineageTag": "b27f67f3-576d-411b-b9f8-1ee96439360a"
          },
          {
            "name": "冻结95%收益区间",
            "expression": "IF(OR(ISBLANK([冻结收益下界]), ISBLANK([冻结收益上界])), BLANK(), FORMAT([冻结收益下界], \"0.000\") & \" ~ \" & FORMAT([冻结收益上界], \"0.000\"))",
            "lineageTag": "dfe6bb85-3304-4cec-a4c1-51343aee8717"
          },
          {
            "name": "样本完成情况",
            "expression": "IF(OR(ISBLANK([冻结分歧样本]), ISBLANK([所需分歧样本])), BLANK(), FORMAT([冻结分歧样本], \"#,0\") & \" / \" & FORMAT([所需分歧样本], \"#,0\"))",
            "lineageTag": "ea276896-cd26-405e-8880-8a5b65dc7d2c"
          },
          {
            "name": "当前晋级决定",
            "description": "依据固定审计状态；筛选器不能绕过成熟、安全、样本或收益门槛",
            "expression": "VAR Ready = CALCULATE(MAX(DashboardState[ProductionReady]), REMOVEFILTERS()) RETURN IF(ISBLANK(Ready), \"等待数据刷新\", IF(Ready = 1, \"需重新审核晋级证据\", \"保留 Champion / 暂不晋级\"))",
            "lineageTag": "a93a53db-e829-4632-8ca3-9b8a512b0c9a"
          },
          {
            "name": "真实业务状态",
            "expression": "\"未验证：真实收益、坏账和DPD保持空值\"",
            "lineageTag": "3b9c769c-3020-40d4-bd76-c2100fb018fd"
          },
          {
            "name": "V2校准通过数",
            "expression": "CALCULATE(MAX(DashboardState[MatchedCalibrationChecks]), REMOVEFILTERS())",
            "formatString": "#,0",
            "lineageTag": "39e37785-458e-4e72-a9e3-542bb9021925"
          },
          {
            "name": "原A/A压力未认证项",
            "expression": "CALCULATE(MAX(DashboardState[AAStressFailures]), REMOVEFILTERS())",
            "formatString": "#,0",
            "lineageTag": "cd6ecc38-af19-40d2-b9b1-9a939cbc07da"
          },
          {
            "name": "假设入组天数",
            "expression": "VAR Daily = SELECTEDVALUE(DailyTraffic[DailyApplications], 5000) VAR Cov = SELECTEDVALUE(Coverage[EligibleFraction], 0.20) VAR Exp = SELECTEDVALUE(Exposure[ExposureFraction], 1.0) VAR D = CALCULATE(MAX(DashboardState[DisagreementFraction]), REMOVEFILTERS()) RETURN ROUNDUP(DIVIDE([所需分歧样本], Daily * Cov * Exp * D), 0)",
            "formatString": "#,0",
            "lineageTag": "59146758-5a67-4808-ba54-3016caabe5ec"
          },
          {
            "name": "假设成熟天数",
            "expression": "CALCULATE(MAX(DashboardState[MaturityDays]), REMOVEFILTERS())",
            "formatString": "#,0",
            "lineageTag": "0ece594a-e9af-431b-baa0-78aaa45df43f"
          },
          {
            "name": "假设宽限天数",
            "expression": "CALCULATE(MAX(DashboardState[GraceDays]), REMOVEFILTERS())",
            "formatString": "#,0",
            "lineageTag": "7bfea8e3-0094-4777-9b17-cee3a441220c"
          },
          {
            "name": "假设最终分析天数",
            "expression": "[假设入组天数] + [假设成熟天数] + [假设宽限天数]",
            "formatString": "#,0",
            "lineageTag": "f24f705e-9a2a-43bf-92a8-57065236fb76"
          },
          {
            "name": "假设入组可行性",
            "expression": "IF([假设入组天数] <= 365, \"满足365天入组约束（假设）\", \"超出365天入组约束（假设）\")",
            "lineageTag": "e2358e9b-81e6-410e-ac35-aeca03058d07"
          }
        ],
